{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/coordinate-system/v1.schema.json",
  "title": "Geometry coordinate system",
  "type": "object",
  "required": ["schema_version", "coordinate_system_id", "axes", "reference_frame", "grid_regularity", "orientation", "periodicity"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "coordinate_system_id": {"type": "string", "minLength": 1},
    "axes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "unit", "sampling_interval", "orientation", "is_time"], "properties": {"name": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "sampling_interval": {"type": ["number", "null"], "exclusiveMinimum": 0}, "orientation": {"type": "string", "minLength": 1}, "is_time": {"type": "boolean"}}, "additionalProperties": false}},
    "reference_frame": {"type": "string", "minLength": 1},
    "grid_regularity": {"enum": ["REGULAR", "IRREGULAR", "GRAPH", "MANIFOLD", "NOT_APPLICABLE"]},
    "orientation": {"type": "string", "minLength": 1},
    "periodicity": {"type": "array", "items": {"type": "boolean"}}
  },
  "additionalProperties": false
}
