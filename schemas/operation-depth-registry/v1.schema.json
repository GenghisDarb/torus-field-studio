{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/operation-depth-registry/v1.schema.json",
  "title": "Geometry operation depth registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "symbol", "depths", "recursive_semantics", "te_applicable"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "symbol": {"const": "r"},
    "depths": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
    "recursive_semantics": {"type": "string", "minLength": 1},
    "te_applicable": {"type": "boolean"}
  },
  "additionalProperties": false
}
