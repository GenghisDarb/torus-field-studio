{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/field-observation/v1.schema.json",
  "title": "Geometry field observation",
  "type": "object",
  "required": ["schema_version", "observation_id", "domain_id", "parent_id", "replicate_id", "run_id", "condition_id", "component_ids", "array_sha256", "shape", "dtype", "mask_id", "acquisition_identity"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"type": "string", "minLength": 1},
    "domain_id": {"type": "string", "minLength": 1},
    "parent_id": {"type": "string", "minLength": 1},
    "replicate_id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "condition_id": {"type": ["string", "null"]},
    "component_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "array_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "dtype": {"type": "string", "minLength": 1},
    "mask_id": {"type": ["string", "null"]},
    "acquisition_identity": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
