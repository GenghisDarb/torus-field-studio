{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/tbx/v1.schema.json",
  "title": "TORUS Bundle Exchange manifest",
  "type": "object",
  "required": ["tbx_version", "run_id", "claim_level", "files"],
  "properties": {
    "tbx_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "claim_level": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}

