{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/tbx/v1.schema.json",
  "title": "TORUS Bundle Exchange manifest",
  "type": "object",
  "required": ["tbx_version", "run_id", "claim_level", "kernel_id", "specification_sha256", "statistics", "files"],
  "properties": {
    "tbx_version": {"const": "1.0.0"},
    "profile": {"enum": ["field-v1", "tld-i-historical-v1", "tld-i-combined-v1", "tld-i-modern-v21", "tld-heldout-primary-v0.2.1", "tld-heldout-specificity-v0.2.1", "tld-heldout-combined-v0.2.1", "tld-heldout-v021-forensic-v0.2.2", "geometry-pilot-v0.3.0", "geometry-method-v2-v0.3.0", "geometry-representation-v0.3.0", "geometry-heldout-v0.3.0", "geometry-combined-v0.3.0"]},
    "run_id": {"type": "string"},
    "claim_level": {"type": "string"},
    "kernel_id": {"type": "string", "minLength": 1},
    "specification_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "statistics": {
      "type": "object",
      "required": ["point_count", "classification_counts", "mean_UI", "mean_NSS", "mean_S_e", "failure_count"],
      "properties": {
        "point_count": {"type": "integer", "minimum": 0},
        "classification_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "mean_UI": {"type": ["number", "null"]}, "mean_NSS": {"type": ["number", "null"]}, "mean_S_e": {"type": ["number", "null"]},
        "failure_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
