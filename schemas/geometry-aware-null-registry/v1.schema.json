{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/geometry-aware-null-registry/v1.schema.json",
  "title": "Geometry aware null registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "selection_timing", "families"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "selection_timing": {"const": "PRE_OUTCOME_REGISTERED"},
    "families": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["null_family_id", "target_destroyed", "nuisances_preserved", "geometry_preserved", "parent_matching", "seed_policy", "child_count", "bias_diagnostics"], "properties": {"null_family_id": {"type": "string"}, "target_destroyed": {"type": "string"}, "nuisances_preserved": {"type": "array", "items": {"type": "string"}}, "geometry_preserved": {"type": "boolean"}, "parent_matching": {"const": true}, "seed_policy": {"type": "string"}, "child_count": {"type": "integer", "minimum": 2}, "bias_diagnostics": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
