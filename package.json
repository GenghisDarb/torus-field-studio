{
  "name": "torus-field-studio",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/studio/vite.config.ts",
    "build": "vite build --config apps/studio/vite.config.ts",
    "preview": "vite preview --config apps/studio/vite.config.ts",
    "typecheck": "tsc -p apps/studio/tsconfig.json",
    "schemas:generate": "node scripts/generate_schema_types.mjs",
    "schemas:check": "node scripts/generate_schema_types.mjs --check",
    "budget": "node scripts/check_bundle_budget.mjs",
    "e2e": "playwright test -c apps/studio/playwright.config.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
