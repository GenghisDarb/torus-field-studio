{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/boundary-condition/v1.schema.json",
  "title": "Geometry boundary condition",
  "type": "object",
  "required": ["schema_version", "boundary_condition_id", "axis_conditions", "source_basis", "padding_allowed"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "boundary_condition_id": {"type": "string", "minLength": 1},
    "axis_conditions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["axis", "kind"], "properties": {"axis": {"type": "string"}, "kind": {"enum": ["PERIODIC", "OPEN", "REFLECTING", "DIRICHLET", "NEUMANN", "SOURCE_DEFINED", "NOT_APPLICABLE"]}}, "additionalProperties": false}},
    "source_basis": {"type": "string", "minLength": 1},
    "padding_allowed": {"type": "boolean"}
  },
  "additionalProperties": false
}
