    "operators": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["operator_id", "input_kind", "output_kind", "depth_semantics", "boundary_compatibility", "mask_compatibility", "historical_status"], "properties": {"operator_id": {"type": "string"}, "input_kind": {"type": "string"}, "output_kind": {"type": "string"}, "depth_semantics": {"type": "string"}, "boundary_compatibility": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "mask_compatibility": {"type": "string"}, "historical_status": {"enum": ["CANONICAL_SEQUENCE_ADAPTER", "NEW_CALIBRATED_GEOMETRY_OPERATOR", "EXPLORATORY_EXCLUDED"]}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
