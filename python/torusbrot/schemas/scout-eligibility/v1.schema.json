{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/scout-eligibility/v1.schema.json",
  "title": "Geometry Scout eligibility",
  "type": "object",
  "required": ["schema_version", "scout_id", "domain_id", "checks", "materialized_fraction", "effective_parent_count", "orbit_length_summary", "closure_authorized", "status", "failure_codes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scout_id": {"type": "string", "minLength": 1},
    "domain_id": {"type": "string", "minLength": 1},
    "checks": {"type": "object", "required": ["source_bytes_verified", "materialized", "coordinates_complete", "units_resolved", "orientation_known", "components_registered", "mask_valid", "missingness_within_bounds", "nondegenerate", "variance_finite", "support_sufficient", "resolution_sufficient", "independent_parent_support", "effective_parent_support", "nested_replicates_identified", "null_ensemble_complete", "nulls_finite", "projection_deterministic", "projection_not_outcome_selected", "projection_justified", "boundary_conditions_known", "operation_depth_applicable", "geometric_scale_applicable", "domain_baseline_materializable", "failure_ledger_active", "sensitivity_adequate"], "properties": {"source_bytes_verified": {"type": "boolean"}, "materialized": {"type": "boolean"}, "coordinates_complete": {"type": "boolean"}, "units_resolved": {"type": "boolean"}, "orientation_known": {"type": "boolean"}, "components_registered": {"type": "boolean"}, "mask_valid": {"type": "boolean"}, "missingness_within_bounds": {"type": "boolean"}, "nondegenerate": {"type": "boolean"}, "variance_finite": {"type": "boolean"}, "support_sufficient": {"type": "boolean"}, "resolution_sufficient": {"type": "boolean"}, "independent_parent_support": {"type": "boolean"}, "effective_parent_support": {"type": "boolean"}, "nested_replicates_identified": {"type": "boolean"}, "null_ensemble_complete": {"type": "boolean"}, "nulls_finite": {"type": "boolean"}, "projection_deterministic": {"type": "boolean"}, "projection_not_outcome_selected": {"type": "boolean"}, "projection_justified": {"type": "boolean"}, "boundary_conditions_known": {"type": "boolean"}, "operation_depth_applicable": {"type": "boolean"}, "geometric_scale_applicable": {"type": "boolean"}, "domain_baseline_materializable": {"type": "boolean"}, "failure_ledger_active": {"type": "boolean"}, "sensitivity_adequate": {"oneOf": [{"type": "boolean"}, {"const": "NOT_APPLICABLE"}]}}, "additionalProperties": false},
    "materialized_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "effective_parent_count": {"type": "number", "minimum": 0},
    "orbit_length_summary": {"type": ["object", "null"]},
    "closure_authorized": {"type": "boolean"},
    "status": {"enum": ["ELIGIBLE", "INELIGIBLE_DEGENERATE", "INELIGIBLE_COORDINATE_AMBIGUITY", "INELIGIBLE_UNIT_AMBIGUITY", "INELIGIBLE_PARENT_SUPPORT", "INELIGIBLE_NULL_INCOMPLETE", "INELIGIBLE_PROJECTION_UNJUSTIFIED", "INELIGIBLE_OPERATION_DEPTH_NOT_APPLICABLE", "INELIGIBLE_BASELINE_UNAVAILABLE", "MATERIALIZATION_BLOCKED"]},
    "failure_codes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
