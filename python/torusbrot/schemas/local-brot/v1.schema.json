{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/local-brot/v1.schema.json",
  "title": "Local TORUS-BROT field point",
  "type": "object",
  "required": ["index", "grid_x", "grid_y", "x", "y", "classification", "eligible", "emerged", "separated_from_null", "closed", "survived", "escaped_from_reference", "recovered", "winner_N", "T_e", "S_e", "UI", "NSS", "SEP", "rms_to_parent", "iterations", "parent_id", "null_policy_id", "trace"],
  "properties": {
    "index": {"type": "integer", "minimum": 0},
    "grid_x": {"type": "integer", "minimum": 0},
    "grid_y": {"type": "integer", "minimum": 0},
    "x": {"type": "number"}, "y": {"type": "number"},
    "classification": {"enum": ["BOUNDED", "ESCAPED", "RECOVERED", "NULL_LIKE", "UNRESOLVED"]},
    "eligible": {"type": "boolean"}, "emerged": {"type": "boolean"},
    "separated_from_null": {"type": "boolean"}, "closed": {"type": "boolean"},
    "survived": {"type": "boolean"}, "escaped_from_reference": {"type": "boolean"},
    "recovered": {"type": ["boolean", "null"]}, "winner_N": {"type": ["integer", "null"]},
    "T_e": {"type": ["integer", "null"]}, "S_e": {"type": "number"},
    "UI": {"type": "number"}, "NSS": {"type": "number"}, "SEP": {"type": "number"},
    "rms_to_parent": {"type": "number", "minimum": 0},
    "iterations": {"type": "integer", "minimum": 0},
    "parent_id": {"type": "string", "minLength": 1},
    "null_policy_id": {"type": "string", "minLength": 1},
    "failure_id": {"type": ["string", "null"]},
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "stage", "coherence"],
        "properties": {
          "step": {"type": "integer", "minimum": 0},
          "stage": {"type": "string"},
          "coherence": {"type": "number"},
          "magnitude": {"type": "number"},
          "null_mean": {"type": "number"},
          "similarity": {"type": "number"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
