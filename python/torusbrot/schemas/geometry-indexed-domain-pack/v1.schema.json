{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torus-field-studio.dev/schemas/geometry-indexed-domain-pack/v1.schema.json",
  "title": "Geometry indexed domain pack",
  "type": "object",
  "required": ["schema_version", "standard_version", "domain_id", "source_id", "stable_source_identifier", "source_url", "license", "raw_source_hashes", "field_kind", "coordinate_system_id", "boundary_condition_id", "mask_contract_id", "missing_data_semantics", "field_component_ids", "independent_parent_key", "nested_replicate_key", "experimental_run_key", "condition_key", "source_acquisition_identity", "canonicalization_identity", "projection_registry_identity", "null_registry_identity", "perturbation_registry_identity", "domain_baseline_identity", "claim_ceiling", "known_limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "standard_version": {"const": "Geometry-Indexed Domain Pack Standard v1.0"},
    "domain_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "source_id": {"type": "string", "minLength": 1},
    "stable_source_identifier": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "license": {"type": "string", "minLength": 1},
    "raw_source_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true},
    "field_kind": {"enum": ["SEQUENCE_1D", "SCALAR_FIELD_2D", "VECTOR_FIELD_2D", "SCALAR_VOLUME_3D", "VECTOR_VOLUME_3D", "SPATIOTEMPORAL_SCALAR_FIELD", "SPATIOTEMPORAL_VECTOR_FIELD", "POINT_CLOUD", "MANIFOLD_SAMPLES", "GRAPH_GEOMETRY", "CORRELATION_GEOMETRY", "MULTIMODAL_COUPLED_FIELD"]},
    "coordinate_system_id": {"type": "string", "minLength": 1},
    "boundary_condition_id": {"type": "string", "minLength": 1},
    "mask_contract_id": {"type": "string", "minLength": 1},
    "missing_data_semantics": {"enum": ["REJECT", "MASK", "REGISTERED_IMPUTATION", "NOT_APPLICABLE"]},
    "field_component_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "independent_parent_key": {"type": "string", "minLength": 1},
    "nested_replicate_key": {"type": ["string", "null"]},
    "experimental_run_key": {"type": ["string", "null"]},
    "condition_key": {"type": ["string", "null"]},
    "source_acquisition_identity": {"type": "string", "minLength": 1},
    "canonicalization_identity": {"type": "string", "minLength": 1},
    "projection_registry_identity": {"type": "string", "minLength": 1},
    "null_registry_identity": {"type": "string", "minLength": 1},
    "perturbation_registry_identity": {"type": "string", "minLength": 1},
    "domain_baseline_identity": {"type": "string", "minLength": 1},
    "claim_ceiling": {"enum": ["DESCRIPTIVE", "COMPUTED_DYNAMICAL", "CALIBRATED_ASSAY", "EXTERNAL_VALIDATION"]},
    "known_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
